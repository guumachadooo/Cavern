<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0-android</TargetFramework>
    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <ApplicationId>hu.sbence.cavern.cavernize</ApplicationId>
    <ApplicationVersion>29</ApplicationVersion>
    <ApplicationDisplayVersion>2.9.0</ApplicationDisplayVersion>
    <ApplicationTitle>Cavernize</ApplicationTitle>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidUseAapt2>true</AndroidUseAapt2>
    <Authors>VoidX</Authors>
    <Description>Cavernize spatial audio player, converter, and channel/object stem extractor for Android.</Description>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <AndroidLinkMode>None</AndroidLinkMode>
  </PropertyGroup>

  <ItemGroup>
    <AndroidAsset Update="Assets\fonts\sf_pro_android_ui.ttf" />
    <AndroidAsset Update="Assets\ffmpeg\**" Condition="Exists('Assets\ffmpeg')" />
    <AndroidAsset Update="Assets\truehdd\**" Condition="Exists('Assets\truehdd')" />
    <AndroidAsset Update="Assets\onnxruntime\**" Condition="Exists('Assets\onnxruntime')" />
    <AndroidNativeLibrary Include="NativeLibs\arm64-v8a\*.so"
                          Abi="arm64-v8a"
                          Condition="Exists('NativeLibs\arm64-v8a')" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Cavern\Cavern.csproj" />
    <ProjectReference Include="..\..\Cavern.Format\Cavern.Format.csproj" />
    <ProjectReference Include="..\Reusable\Cavernize.Logic\Cavernize.Logic.csproj" />
  </ItemGroup>
</Project>
