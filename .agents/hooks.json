{
  "cavernize-session-briefing": {
    "SessionStart": [
      {
        "type": "command",
        "command": "python3 ./hooks/session_start.py",
        "timeout": 10
      }
    ]
  },
  "cavernize-guardrails": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./hooks/guard_command.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "edit_file|write_file",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./hooks/guard_files.py",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
